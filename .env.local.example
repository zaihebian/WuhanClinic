# ============================================================
# 留空 = 本地演示模式（数据存浏览器 localStorage）
# 填上 = 自动切换到 Supabase 数据库
#
# 只有下面这两行需要改。值从 Supabase 控制台复制，整段粘贴，不要加引号。
# ============================================================

# 第 1 行：项目地址，长这样 https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 第 2 行：API key。新版是 sb_publishable_xxxx 开头，旧版是 eyJhbGciOi... 开头，两种都认
NEXT_PUBLIC_SUPABASE_ANON_KEY=
